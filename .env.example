# ============================================================================
# MULTI-TENANCY CONFIGURATION [IMPLEMENTED]
# ============================================================================

# Platform-reserved subdomains (comma-separated)
# REQUIRED: Tenants cannot register these subdomains
# These subdomains are exclusively for platform use
MultiTenancy__ReservedSubdomains=store,storeapi,admin,api,auth,docs,health,status,cdn,assets

# Platform-excluded subdomains (comma-separated)
# REQUIRED: Bypass tenant resolution for these subdomains
# Requests to these subdomains are handled as platform endpoints
MultiTenancy__ExcludedSubdomains=store,storeapi,admin

# ============================================================================
# CORS CONFIGURATION [IMPLEMENTED]
# ============================================================================

# Allowed CORS origins (comma-separated full URLs)
# REQUIRED: Must include scheme (http/https)
# Security: Use HTTPS in production
Cors__AllowedOrigins=https://store.kromic.in,https://admin.kromic.in,http://localhost:3000,http://localhost:5173

# ============================================================================
# LOGGING CONFIGURATION [IMPLEMENTED]
# ============================================================================

# Default log level
# Valid: Trace, Debug, Information, Warning, Error, Fatal, None
# Optional: Default Information
Logging__LogLevel__Default=Information

# ASP.NET Core framework log level
# Optional: Default Warning
Logging__LogLevel__Microsoft_AspNetCore=Warning

# Entity Framework Core log level
# Optional: Default Information
Logging__LogLevel__Microsoft_EntityFrameworkCore=Information


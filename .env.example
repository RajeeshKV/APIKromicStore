# ============================================================================
# KromicStore Backend - Complete Environment Variables Configuration
# ============================================================================
# This file is the SINGLE SOURCE OF TRUTH for ALL environment variables
# supported by the KromicStore backend application, including:
# - Currently implemented configurations
# - Reserved/planned configurations for future implementation
# - All external integrations
#
# Copy this file to .env and fill in your values for your environment.
#
# STATUS LEGEND:
# [IMPLEMENTED] - Configuration used in current implementation
# [RESERVED]    - Configuration reserved for planned/future implementation
# ============================================================================

# ============================================================================
# APPLICATION CONFIGURATION [IMPLEMENTED]
# ============================================================================

# ASP.NET Core environment mode
# Valid: Development, Staging, Production
# Default: Production
ASPNETCORE_ENVIRONMENT=Development

# ============================================================================
# DATABASE CONFIGURATION [IMPLEMENTED]
# ============================================================================

# PostgreSQL connection string
# Format: Host=<host>;Port=<port>;Database=<db>;Username=<user>;Password=<pass>;
# REQUIRED: Must be configured for application to start
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=kromic_store;Username=postgres;Password=postgres;

# ============================================================================
# AUTHENTICATION & AUTHORIZATION [IMPLEMENTED]
# ============================================================================

# JWT (JSON Web Token) Configuration [IMPLEMENTED]
# Secret key for signing JWT tokens
# REQUIRED: Minimum 32 characters
# SECURITY: Use strong random value in production (64+ characters recommended)
Jwt__Secret=your-very-secure-secret-key-must-be-at-least-32-characters-long!

# Token issuer identifier
# REQUIRED: Must match frontend expectations
Jwt__Issuer=kromic-store

# Token audience identifier
# REQUIRED: Must match frontend expectations
Jwt__Audience=kromic-store-api

# Access token expiration in minutes
# Optional: Default 15, Range: 1-1440
Jwt__AccessTokenExpirationMinutes=15

# Refresh token expiration in days
# Optional: Default 7, Range: 1-730
Jwt__RefreshTokenExpirationDays=7

# ============================================================================
# EXTERNAL AUTHENTICATION [RESERVED]
# ============================================================================

# Google OAuth Configuration [RESERVED FOR FUTURE]
# Documentation: docs/Google-OAuth-Integration.md (planned)
# Status: Not yet implemented

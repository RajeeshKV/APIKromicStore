# ============================================================================
# KromicStore Backend - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your configuration values.
# Never commit .env file to version control - it contains secrets.
#
# For Docker: Copy values to docker-compose.yml environment section
# For Production: Set environment variables in Render/Fly.io dashboard
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string
# Format: Host=<hostname>;Port=<port>;Database=<database>;Username=<user>;Password=<password>
#
# Local Development:
# Host=localhost;Port=5432;Database=kromic_store_dev;Username=postgres;Password=postgres;Include Error Detail=true;
#
# Production (Supabase):
# Use the PostgreSQL connection string from Supabase dashboard
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=kromic_store_dev;Username=postgres;Password=postgres;Include Error Detail=true;

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
# Secret key for signing JWT tokens (minimum 32 characters, random)
# Generate with: openssl rand -base64 32
Jwt__Secret=your-super-secret-key-must-be-at-least-32-characters-long!

# Token issuer (any string, typically domain name)
Jwt__Issuer=kromic-store

# Token audience (API identifier)
Jwt__Audience=kromic-store-api

# Access token expiration in minutes (default: 15)
Jwt__AccessTokenExpirationMinutes=15

# Refresh token expiration in days (default: 7)
Jwt__RefreshTokenExpirationDays=7

# ============================================================================
# MULTI-TENANCY CONFIGURATION
# ============================================================================
# Reserved subdomains that cannot be registered by tenants
# Comma-separated list
MultiTenancy__ReservedSubdomains=store,storeapi,admin,api,auth,docs,health,status,cdn,assets

# Excluded subdomains (platform-owned, no tenant resolution)
# Comma-separated list
MultiTenancy__ExcludedSubdomains=store,storeapi,admin

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Allowed origins for CORS requests
# Comma-separated list of full URLs (https://domain.com)
# IMPORTANT: In production, specify exact origins, never use wildcard *
#
# Development:
# http://localhost:3000,http://localhost:5173
#
# Production:
# https://store.kromic.in,https://admin.kromic.in
Cors__AllowedOrigins=https://store.kromic.in,https://admin.kromic.in,http://localhost:3000,http://localhost:5173

# ============================================================================
# BREVO EMAIL SERVICE
# ============================================================================
# Enable email service
Brevo__Enabled=false

# Brevo API key (get from Brevo dashboard)
Brevo__ApiKey=PLACEHOLDER_BREVO_API_KEY

# Sender name (displayed in email From field)
Brevo__SenderName=KromicStore

# Sender email (must be verified in Brevo)
Brevo__SenderEmail=noreply@kromic.store

# Webhook secret for incoming email events
Brevo__WebhookSecret=PLACEHOLDER_BREVO_WEBHOOK_SECRET

# Brevo API base URL
Brevo__BaseUrl=https://api.brevo.com/v3

# Request timeout in seconds
Brevo__RequestTimeoutSeconds=30

# Max retry attempts for failed requests
Brevo__MaxRetries=3

# Initial retry delay in milliseconds
Brevo__InitialRetryDelayMilliseconds=1000

# Exponential backoff multiplier for retries
Brevo__RetryBackoffMultiplier=2.0

# Email template IDs (get from Brevo dashboard - Template ID field)
# Format: Brevo__TemplateIds__<TemplateName>=<TemplateId>
Brevo__TemplateIds__Welcome=0
Brevo__TemplateIds__VerifyEmail=0
Brevo__TemplateIds__ForgotPassword=0
Brevo__TemplateIds__PasswordChanged=0
Brevo__TemplateIds__TenantInvitation=0
Brevo__TemplateIds__CustomerInvitation=0
Brevo__TemplateIds__OrderConfirmation=0
Brevo__TemplateIds__OrderCancelled=0
Brevo__TemplateIds__ShipmentCreated=0
Brevo__TemplateIds__ShipmentDelivered=0
Brevo__TemplateIds__ReturnRequested=0
Brevo__TemplateIds__RefundCompleted=0
Brevo__TemplateIds__ContactUsAutoReply=0
Brevo__TemplateIds__ContactUsInternal=0

# ============================================================================
# CLOUDINARY MEDIA SERVICE
# ============================================================================
# Enable media/image service
Cloudinary__Enabled=false

# Cloudinary cloud name (from Settings > Account)
Cloudinary__CloudName=PLACEHOLDER_CLOUDINARY_CLOUD_NAME

# Cloudinary API key (from Settings > API Keys)
Cloudinary__ApiKey=PLACEHOLDER_CLOUDINARY_API_KEY

# Cloudinary API secret (from Settings > API Keys)
Cloudinary__ApiSecret=PLACEHOLDER_CLOUDINARY_API_SECRET

# Maximum file size in bytes (default: 10485760 = 10 MB)
Cloudinary__MaxFileSizeBytes=10485760

# Request timeout in seconds
Cloudinary__RequestTimeoutSeconds=60

# Max retry attempts
Cloudinary__MaxRetries=3

# Initial retry delay in milliseconds
Cloudinary__InitialRetryDelayMilliseconds=1000

# Exponential backoff multiplier
Cloudinary__RetryBackoffMultiplier=2.0

# Allowed MIME types (comma-separated or configured in appsettings)
# image/jpeg, image/png, image/webp, image/gif

# Allowed file extensions (comma-separated or configured in appsettings)
# .jpg, .jpeg, .png, .webp, .gif

# ============================================================================
# RAZORPAY PAYMENT GATEWAY
# ============================================================================
# Enable payment gateway
Razorpay__Enabled=false

# Razorpay Key ID (from Settings > API Keys > Key ID)
Razorpay__KeyId=PLACEHOLDER_RAZORPAY_KEY_ID

# Razorpay Key Secret (from Settings > API Keys > Key Secret)
Razorpay__KeySecret=PLACEHOLDER_RAZORPAY_KEY_SECRET

# Webhook secret for payment events
Razorpay__WebhookSecret=PLACEHOLDER_RAZORPAY_WEBHOOK_SECRET

# Razorpay API base URL
Razorpay__BaseUrl=https://api.razorpay.com/v1

# Request timeout in seconds
Razorpay__RequestTimeoutSeconds=30

# Max retry attempts
Razorpay__MaxRetries=3

# Initial retry delay in milliseconds
Razorpay__InitialRetryDelayMilliseconds=1000

# Exponential backoff multiplier
Razorpay__RetryBackoffMultiplier=2.0

# Allowed currencies (comma-separated)
Razorpay__AllowedCurrencies=INR,USD,EUR,GBP

# Default currency
Razorpay__DefaultCurrency=INR

# Enable webhook signature verification
Razorpay__EnableWebhookVerification=true

# Webhook verification retry count
Razorpay__WebhookRetryCount=5

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
# Environment: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# Server URL and port
# Development: http://localhost:5000
# Production: http://+:8080 (inside Docker container)
ASPNETCORE_URLS=http://+:5000

# ============================================================================
# LOGGING
# ============================================================================
# Log level: Error, Warning, Information, Debug, Trace
# Default: Information
SERILOG_LOGLEVEL=Information

# ============================================================================
# DOCKER-SPECIFIC (for docker-compose)
# ============================================================================
# Database root password (must match ConnectionString)
DB_PASSWORD=postgres

# Base domain for multi-tenancy
BASE_DOMAIN=localhost:5000

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
# ✓ Generate secure JWT__Secret (min 32 chars, random)
# ✓ Set ConnectionStrings__DefaultConnection to production database
# ✓ Configure valid email templates in Brevo (get template IDs)
# ✓ Configure Cloudinary credentials
# ✓ Configure Razorpay credentials
# ✓ Set Cors__AllowedOrigins to your production domain
# ✓ Set Jwt__Issuer and Audience to your domain
# ✓ Set MultiTenancy__ReservedSubdomains for your platform
# ✓ Test health endpoint: GET /api/v1/health
# ✓ Test authentication: POST /api/v1/auth/login
# ✓ Monitor application logs for errors

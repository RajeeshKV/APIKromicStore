{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "your-super-secret-key-must-be-at-least-32-characters-long!",
    "Issuer": "kromic-store",
    "Audience": "kromic-store-api",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "MultiTenancy": {
    "ReservedSubdomains": "store,storeapi,admin,api,auth,docs,health,status,cdn,assets",
    "ExcludedSubdomains": "store,storeapi,admin"
  },
  "Cors": {
    "AllowedOrigins": "https://store.kromic.in,https://admin.kromic.in,http://localhost:3000,http://localhost:5173"
  },
  "Brevo": {
    "ApiKey": "PLACEHOLDER_BREVO_API_KEY",
    "SenderName": "KromicStore",
    "SenderEmail": "noreply@kromic.store",
    "WebhookSecret": "PLACEHOLDER_BREVO_WEBHOOK_SECRET",
    "BaseUrl": "https://api.brevo.com/v3",
    "RequestTimeoutSeconds": 30,
    "MaxRetries": 3,
    "InitialRetryDelayMilliseconds": 1000,
    "RetryBackoffMultiplier": 2.0,
    "Enabled": false,
    "TemplateIds": {
      "Welcome": 0,
      "VerifyEmail": 0,
      "ForgotPassword": 0,
      "PasswordChanged": 0,
      "TenantInvitation": 0,
      "CustomerInvitation": 0,
      "OrderConfirmation": 0,
      "OrderCancelled": 0,
      "ShipmentCreated": 0,
      "ShipmentDelivered": 0,
      "ReturnRequested": 0,
      "RefundCompleted": 0,
      "ContactUsAutoReply": 0,
      "ContactUsInternal": 0
    }
  },
  "Cloudinary": {
    "CloudName": "PLACEHOLDER_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "PLACEHOLDER_CLOUDINARY_API_KEY",
    "ApiSecret": "PLACEHOLDER_CLOUDINARY_API_SECRET",
    "MaxFileSizeBytes": 10485760,
    "AllowedMimeTypes": ["image/jpeg", "image/png", "image/webp", "image/gif"],
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp", ".gif"],
    "RequestTimeoutSeconds": 60,
    "MaxRetries": 3,
    "InitialRetryDelayMilliseconds": 1000,
    "RetryBackoffMultiplier": 2.0,
    "Enabled": false
  },
  "Razorpay": {
    "KeyId": "PLACEHOLDER_RAZORPAY_KEY_ID",
    "KeySecret": "PLACEHOLDER_RAZORPAY_KEY_SECRET",
    "WebhookSecret": "PLACEHOLDER_RAZORPAY_WEBHOOK_SECRET",
    "AllowedCurrencies": ["INR", "USD", "EUR", "GBP"],
    "BaseUrl": "https://api.razorpay.com/v1",
    "RequestTimeoutSeconds": 30,
    "MaxRetries": 3,
    "InitialRetryDelayMilliseconds": 1000,
    "RetryBackoffMultiplier": 2.0,
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
